{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindspark-supertato",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "mind.supertato.top",
      "custom_domain": true
    }
  ]
}
